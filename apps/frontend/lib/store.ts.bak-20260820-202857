"use client";

import { create } from "zustand";
import { createClient } from "@/lib/supabase/client";

const supabase = createClient();

// =============================================================================
// Row mappers (snake_case DB rows -> camelCase domain types)
// =============================================================================

function mapSupplierRow(row: any): Supplier {
  return { id: row.id, name: row.name, phone: row.phone, address: row.address ?? undefined };
}
function mapRawMaterialRow(row: any): RawMaterial {
  return {
    id: row.id,
    name: row.name,
    unit: row.unit,
    quantityInStock: Number(row.quantity_in_stock),
    avgUnitCost: Number(row.avg_unit_cost),
    lowStockThreshold: Number(row.low_stock_threshold),
  };
}
function mapReceiptRow(row: any): PurchaseReceipt {
  return { id: row.id, supplierId: row.supplier_id, purchaseDate: row.purchase_date };
}
function mapReceiptLineRow(row: any): PurchaseReceiptLine {
  return { id: row.id, receiptId: row.receipt_id, rawMaterialId: row.raw_material_id, qty: Number(row.qty), cost: Number(row.cost) };
}
function mapWrapperRow(row: any): Wrapper {
  return {
    id: row.id,
    name: row.name,
    rawMaterialId: row.raw_material_id,
    gramsPerUnit: Number(row.grams_per_unit),
    stockQty: Number(row.stock_qty),
    lowStockThreshold: Number(row.low_stock_threshold),
  };
}
function mapBoxRow(row: any): Box {
  return {
    id: row.id,
    name: row.name,
    rawMaterialId: row.raw_material_id,
    gramsPerUnit: Number(row.grams_per_unit),
    stockQty: Number(row.stock_qty),
    lowStockThreshold: Number(row.low_stock_threshold),
  };
}
function mapWrapperRunRow(row: any): WrapperProductionRun {
  return {
    id: row.id,
    wrapperId: row.wrapper_id,
    quantityProduced: Number(row.quantity_produced),
    gramsConsumed: Number(row.grams_consumed),
    date: row.run_date,
  };
}
function mapBoxRunRow(row: any): BoxProductionRun {
  return {
    id: row.id,
    boxId: row.box_id,
    quantityProduced: Number(row.quantity_produced),
    gramsConsumed: Number(row.grams_consumed),
    date: row.run_date,
  };
}
function mapCartonConfigRow(row: any): CartonConfiguration {
  return {
    id: row.id,
    name: row.name,
    wrapperId: row.wrapper_id,
    packetsPerBox: Number(row.packets_per_box),
    boxId: row.box_id,
    boxesPerCarton: Number(row.boxes_per_carton),
    usedInPackingRun: Boolean(row.used_in_packing_run),
  };
}
function mapBatchRow(row: any): ProductionBatch {
  return {
    id: row.id,
    batchDate: row.batch_date,
    outputYieldKg: Number(row.output_yield_kg),
    wastageKg: Number(row.wastage_kg),
    leftoverQtyKg: Number(row.leftover_qty_kg),
    bulkCostPerKg: Number(row.bulk_cost_per_kg),
    overheadTotal: Number(row.overhead_total),
    status: row.status,
    leftoverSourceBatchId: row.leftover_source_batch_id ?? undefined,
    leftoverKgConsumed: row.leftover_kg_consumed != null ? Number(row.leftover_kg_consumed) : undefined,
  };
}
function mapFinishedCartonRow(row: any): FinishedCarton {
  return {
    id: row.id,
    name: row.name,
    sourceBatchId: row.source_batch_id,
    configId: row.config_id,
    cartonsProduced: Number(row.cartons_produced),
    packetsPerCarton: Number(row.packets_per_carton),
    costPerCarton: Number(row.cost_per_carton),
    costPerBox: Number(row.cost_per_box),
    costPerPacket: Number(row.cost_per_packet),
    stockQty: Number(row.stock_qty),
  };
}
function mapCustomerRow(row: any): Customer {
  return { id: row.id, name: row.name, phone: row.phone, currentBalance: Number(row.current_balance) };
}
function mapCustomerItemPriceRow(row: any): CustomerItemPrice {
  return {
    customerId: row.customer_id,
    itemId: row.item_id,
    lastSoldPrice: Number(row.last_sold_price),
    lastSoldDate: row.last_sold_date,
  };
}
function mapInvoiceRow(row: any, customerName: string, items: InvoiceLineRecord[]): Invoice {
  return {
    id: row.invoice_number ?? row.id,
    customerId: row.customer_id,
    customerName,
    invoiceDate: row.invoice_date,
    totalAmount: Number(row.total_amount),
    items,
  };
}
function mapInvoiceItemRow(row: any): InvoiceLineRecord {
  return {
    itemId: row.finished_carton_id,
    itemName: row.item_name,
    qty: Number(row.qty),
    unitPrice: Number(row.unit_price),
    subtotal: Number(row.subtotal),
    priceSourceNote: row.price_source_note ?? undefined,
  };
}
function mapLedgerRow(row: any): LedgerEntry {
  return {
    id: row.id,
    customerId: row.customer_id,
    type: row.type,
    direction: row.direction,
    amount: Number(row.amount),
    runningBalance: Number(row.running_balance),
    date: row.entry_date,
    note: row.note ?? undefined,
  };
}
function mapPaymentRow(row: any, customerName: string): Payment {
  return {
    id: row.id,
    customerId: row.customer_id,
    customerName,
    amount: Number(row.amount),
    direction: row.direction,
    note: row.note ?? "",
    paidAt: row.paid_at,
  };
}
function mapSettingsRow(row: any): AppSettings {
  return {
    businessName: row.business_name,
    address: row.address,
    invoiceFooterText: row.invoice_footer_text ?? "",
    defaultProfitMarginPercent: Number(row.default_profit_margin_percent),
    lowStockThresholdDefault: Number(row.low_stock_threshold_default),
  };
}

// =============================================================================
// Types (BRS v1.2 / Frontend Spec v2.2 domain model)
// =============================================================================

export type Supplier = { id: string; name: string; phone: string; address?: string };

export type RawMaterial = {
  id: string;
  name: string;
  unit: string;
  quantityInStock: number;
  avgUnitCost: number;
  lowStockThreshold: number;
};

export type PurchaseReceipt = { id: string; supplierId: string; purchaseDate: string };

export type PurchaseReceiptLine = { id: string; receiptId: string; rawMaterialId: string; qty: number; cost: number };

export type Wrapper = {
  id: string;
  name: string;
  rawMaterialId: string;
  gramsPerUnit: number;
  stockQty: number;
  lowStockThreshold: number;
};

export type Box = {
  id: string;
  name: string;
  rawMaterialId: string;
  gramsPerUnit: number;
  stockQty: number;
  lowStockThreshold: number;
};

export type WrapperProductionRun = { id: string; wrapperId: string; quantityProduced: number; gramsConsumed: number; date: string };

export type BoxProductionRun = { id: string; boxId: string; quantityProduced: number; gramsConsumed: number; date: string };

export type CartonConfiguration = {
  id: string;
  name: string;
  wrapperId: string;
  packetsPerBox: number;
  boxId: string;
  boxesPerCarton: number;
  usedInPackingRun: boolean;
};

export type ProductionBatch = {
  id: string;
  batchDate: string;
  outputYieldKg: number;
  wastageKg: number;
  leftoverQtyKg: number;
  bulkCostPerKg: number;
  overheadTotal: number;
  status: "in_progress" | "completed";
  leftoverSourceBatchId?: string;
  leftoverKgConsumed?: number;
};

export type FinishedCarton = {
  id: string;
  name: string;
  sourceBatchId: string;
  configId: string;
  cartonsProduced: number;
  packetsPerCarton: number;
  costPerCarton: number;
  costPerBox: number;
  costPerPacket: number;
  stockQty: number;
};

export type Customer = { id: string; name: string; phone: string; currentBalance: number };

export type CustomerItemPrice = { customerId: string; itemId: string; lastSoldPrice: number; lastSoldDate: string };

export type InvoiceLineRecord = {
  itemId: string;
  itemName: string;
  qty: number;
  unitPrice: number;
  subtotal: number;
  priceSourceNote?: string;
};

export type Invoice = {
  id: string;
  customerId: string;
  customerName: string;
  invoiceDate: string;
  totalAmount: number;
  items: InvoiceLineRecord[];
};

// NOTE ON DIRECTION SEMANTICS (open question, BRS section 11): "received" =
// payment received from the customer, "given" = amount given to the
// customer / credit-note adjustment. Both currently reduce the outstanding
// running balance server-side (fn_record_payment). Confirm sign convention
// with client before go-live.
export type LedgerEntryType = "invoice" | "payment" | "adjustment";
export type LedgerDirection = "received" | "given";

export type LedgerEntry = {
  id: string;
  customerId: string;
  type: LedgerEntryType;
  direction: LedgerDirection | null;
  amount: number;
  runningBalance: number;
  date: string;
  note?: string;
};

export type Payment = {
  id: string;
  customerId: string;
  customerName: string;
  amount: number;
  direction: LedgerDirection;
  note: string;
  paidAt: string;
};

export type AppSettings = {
  businessName: string;
  address: string;
  invoiceFooterText: string;
  defaultProfitMarginPercent: number;
  lowStockThresholdDefault: number;
};

// =============================================================================
// Unit-conversion helper for Wrapper/Box grams-per-unit consumption
// =============================================================================

function unitToGramsMultiplier(unit: string): number {
  const u = unit.trim().toLowerCase();
  if (u === "kg" || u === "kilogram" || u === "kilograms") return 1000;
  if (u === "g" || u === "gram" || u === "grams") return 1;
  return 1;
}

export function computePackagingUnitCost(gramsPerUnit: number, rawMaterial: RawMaterial | undefined): number {
  if (!rawMaterial) return 0;
  const multiplier = unitToGramsMultiplier(rawMaterial.unit);
  const costPerGram = rawMaterial.avgUnitCost / multiplier;
  return gramsPerUnit * costPerGram;
}

const emptySettings: AppSettings = {
  businessName: "",
  address: "",
  invoiceFooterText: "",
  defaultProfitMarginPercent: 20,
  lowStockThresholdDefault: 50,
};

// =============================================================================
// Store - fully live, no local seed/mock data. Every module loads from and
// writes to Supabase (PostgREST reads + fn_* RPC writes for anything
// transactional/multi-table).
// =============================================================================

type State = {
  suppliers: Supplier[];
  rawMaterials: RawMaterial[];
  receipts: PurchaseReceipt[];
  receiptLines: PurchaseReceiptLine[];
  wrappers: Wrapper[];
  boxes: Box[];
  wrapperProductionRuns: WrapperProductionRun[];
  boxProductionRuns: BoxProductionRun[];
  cartonConfigurations: CartonConfiguration[];
  productionBatches: ProductionBatch[];
  finishedCartons: FinishedCarton[];
  customers: Customer[];
  customerItemPrices: CustomerItemPrice[];
  invoices: Invoice[];
  ledgerEntries: LedgerEntry[];
  payments: Payment[];
  settings: AppSettings;
  hydrated: boolean;

  loadAll: () => Promise<void>;

  // Suppliers / Raw Materials / Purchase Receipts
  loadRawMaterialsModule: () => Promise<void>;
  addSupplier: (item: { name: string; phone: string; address?: string }) => Promise<string>;
  addRawMaterial: (item: { name: string; unit: string; lowStockThreshold: number }) => Promise<string>;
  createPurchaseReceipt: (input: {
    supplierId: string;
    purchaseDate: string;
    items: { rawMaterialId: string; qty: number; cost: number }[];
  }) => Promise<string>;
  deleteReceipt: (receiptId: string) => Promise<void>;
  updateReceipt: (receiptId: string, input: {
    supplierId: string;
    purchaseDate: string;
    items: { rawMaterialId: string; qty: number; cost: number }[];
  }) => Promise<void>;

  // Wrapper / Box
  loadPackagingModule: () => Promise<void>;
  addWrapper: (item: { name: string; rawMaterialId: string; gramsPerUnit: number; lowStockThreshold: number }) => Promise<string>;
  produceWrapper: (wrapperId: string, quantityProduced: number) => Promise<{ ok: boolean; reason?: string }>;
  addBox: (item: { name: string; rawMaterialId: string; gramsPerUnit: number; lowStockThreshold: number }) => Promise<string>;
  produceBox: (boxId: string, quantityProduced: number) => Promise<{ ok: boolean; reason?: string }>;
  wrapperUnitCost: (wrapperId: string) => number;
  boxUnitCost: (boxId: string) => number;

  // Carton Configuration
  loadCartonConfigurations: () => Promise<void>;
  addCartonConfiguration: (input: {
    name: string;
    wrapperId: string;
    packetsPerBox: number;
    boxId: string;
    boxesPerCarton: number;
  }) => Promise<string>;
  updateCartonConfiguration: (id: string, patch: { name?: string; packetsPerBox?: number; boxesPerCarton?: number }) => Promise<{ ok: boolean; reason?: string }>;

  // Production Batch
  loadProductionBatches: () => Promise<void>;
  createBatch: (input: {
    consumptions: { rawMaterialId: string; qty: number }[];
    outputYieldKg: number;
    wastageKg: number;
    leftoverBatchId?: string;
    leftoverKgUsed?: number;
    otherExpenses?: { name: string; amount: number }[];
  }) => Promise<string>;
  allocateOverhead: (batchId: string, electricity: number, gas: number, rent: number) => Promise<void>;

  // Packing Run
  loadFinishedCartons: () => Promise<void>;
  createPackingRun: (input: { batchId: string; configId: string; cartonsProduced: number }) => Promise<void>;

  // Customers, Invoicing, Ledger, Payments
  loadCustomersModule: () => Promise<void>;
  addCustomer: (item: { name: string; phone: string; openingBalance: number }) => Promise<string>;
  recordLedgerEntry: (customerId: string, amount: number, direction: LedgerDirection, note: string) => Promise<void>;
  lastSoldPriceInfo: (customerId: string, itemId: string) => { price: number; date: string } | undefined;
  createInvoice: (input: {
    customerId: string;
    lines: { itemId: string; qty: number; unitPrice: number; priceSourceNote?: string }[];
  }) => Promise<string>;

  // Settings
  loadSettings: () => Promise<void>;
  updateSettings: (patch: Partial<AppSettings>) => Promise<void>;
};

export const useStore = create<State>()((set, get) => ({
  suppliers: [],
  rawMaterials: [],
  receipts: [],
  receiptLines: [],
  wrappers: [],
  boxes: [],
  wrapperProductionRuns: [],
  boxProductionRuns: [],
  cartonConfigurations: [],
  productionBatches: [],
  finishedCartons: [],
  customers: [],
  customerItemPrices: [],
  invoices: [],
  ledgerEntries: [],
  payments: [],
  settings: emptySettings,
  hydrated: false,

  loadAll: async () => {
    await Promise.all([
      get().loadRawMaterialsModule(),
      get().loadPackagingModule(),
      get().loadCartonConfigurations(),
      get().loadProductionBatches(),
      get().loadFinishedCartons(),
      get().loadCustomersModule(),
      get().loadSettings(),
    ]);
    set({ hydrated: true });
  },

  // ---------------------------------------------------------------------
  // Suppliers / Raw Materials / Purchase Receipts
  // ---------------------------------------------------------------------

  loadRawMaterialsModule: async () => {
    const [suppliersRes, rawMaterialsRes, receiptsRes, receiptLinesRes] = await Promise.all([
      supabase.from("suppliers").select("*").order("created_at", { ascending: false }),
      supabase.from("raw_materials").select("*").order("name"),
      supabase.from("purchase_receipts").select("*").order("purchase_date", { ascending: false }),
      supabase.from("purchase_receipt_lines").select("*"),
    ]);
    set({
      suppliers: (suppliersRes.data ?? []).map(mapSupplierRow),
      rawMaterials: (rawMaterialsRes.data ?? []).map(mapRawMaterialRow),
      receipts: (receiptsRes.data ?? []).map(mapReceiptRow),
      receiptLines: (receiptLinesRes.data ?? []).map(mapReceiptLineRow),
    });
  },

  addSupplier: async (item) => {
    const { data, error } = await supabase
      .from("suppliers")
      .insert({ name: item.name, phone: item.phone, address: item.address ?? null })
      .select()
      .single();
    if (error || !data) throw new Error(error?.message ?? "Failed to add supplier");
    const supplier = mapSupplierRow(data);
    set((s) => ({ suppliers: [...s.suppliers, supplier] }));
    return supplier.id;
  },

  addRawMaterial: async (item) => {
    const { data, error } = await supabase
      .from("raw_materials")
      .insert({ name: item.name, unit: item.unit, low_stock_threshold: item.lowStockThreshold })
      .select()
      .single();
    if (error || !data) throw new Error(error?.message ?? "Failed to add raw material");
    const material = mapRawMaterialRow(data);
    set((s) => ({ rawMaterials: [...s.rawMaterials, material] }));
    return material.id;
  },

  // FR-5/FR-6/FR-7: server-side RPC (fn_create_purchase_receipt) recalculates
  // each affected raw material's weighted-average cost atomically.
  createPurchaseReceipt: async (input) => {
    const { data, error } = await supabase.rpc("fn_create_purchase_receipt", {
      p_supplier_id: input.supplierId,
      p_purchase_date: input.purchaseDate,
      p_items: input.items.map((i) => ({ rawMaterialId: i.rawMaterialId, qty: i.qty, cost: i.cost })),
    });
    if (error || !data) throw new Error(error?.message ?? "Failed to save purchase receipt");
    await get().loadRawMaterialsModule();
    return (data as any).receiptId as string;
  },

  deleteReceipt: async (receiptId) => {
    const { error } = await supabase.rpc("fn_delete_purchase_receipt", { p_receipt_id: receiptId });
    if (error) throw new Error(error.message ?? "Failed to delete receipt");
    await get().loadRawMaterialsModule();
  },

  updateReceipt: async (receiptId, input) => {
    const { error } = await supabase.rpc("fn_update_purchase_receipt", {
      p_receipt_id: receiptId,
      p_supplier_id: input.supplierId,
      p_purchase_date: input.purchaseDate,
      p_items: input.items.map((i) => ({ rawMaterialId: i.rawMaterialId, qty: i.qty, cost: i.cost })),
    });
    if (error) throw new Error(error.message ?? "Failed to update receipt");
    await get().loadRawMaterialsModule();
  },

  // ---------------------------------------------------------------------
  // Wrapper / Box - Define + Produce (FR-11 - FR-15)
  // ---------------------------------------------------------------------

  loadPackagingModule: async () => {
    const [wrappersRes, boxesRes, wrapperRunsRes, boxRunsRes] = await Promise.all([
      supabase.from("wrappers").select("*").order("name"),
      supabase.from("boxes").select("*").order("name"),
      supabase.from("wrapper_production_runs").select("*").order("run_date", { ascending: false }),
      supabase.from("box_production_runs").select("*").order("run_date", { ascending: false }),
    ]);
    set({
      wrappers: (wrappersRes.data ?? []).map(mapWrapperRow),
      boxes: (boxesRes.data ?? []).map(mapBoxRow),
      wrapperProductionRuns: (wrapperRunsRes.data ?? []).map(mapWrapperRunRow),
      boxProductionRuns: (boxRunsRes.data ?? []).map(mapBoxRunRow),
    });
  },

  addWrapper: async (item) => {
    const { data, error } = await supabase.functions.invoke("wrappers-create", {
      body: { name: item.name, rawMaterialId: item.rawMaterialId, gramsPerUnit: item.gramsPerUnit, lowStockThreshold: item.lowStockThreshold },
    });
    if (error || !data?.data) throw new Error(error?.message ?? "Failed to add wrapper");
    await get().loadPackagingModule();
    return (data.data as any).id as string;
  },

  produceWrapper: async (wrapperId, quantityProduced) => {
    const { data, error } = await supabase.rpc("fn_produce_wrapper", { p_wrapper_id: wrapperId, p_qty: quantityProduced });
    if (error) return { ok: false, reason: error.message };
    await get().loadPackagingModule();
    return { ok: true, ...(data as any) };
  },

  addBox: async (item) => {
    const { data, error } = await supabase.functions.invoke("boxes-create", {
      body: { name: item.name, rawMaterialId: item.rawMaterialId, gramsPerUnit: item.gramsPerUnit, lowStockThreshold: item.lowStockThreshold },
    });
    if (error || !data?.data) throw new Error(error?.message ?? "Failed to add box");
    await get().loadPackagingModule();
    return (data.data as any).id as string;
  },

  produceBox: async (boxId, quantityProduced) => {
    const { data, error } = await supabase.rpc("fn_produce_box", { p_box_id: boxId, p_qty: quantityProduced });
    if (error) return { ok: false, reason: error.message };
    await get().loadPackagingModule();
    return { ok: true, ...(data as any) };
  },

  wrapperUnitCost: (wrapperId) => {
    const s = get();
    const wrapper = s.wrappers.find((w) => w.id === wrapperId);
    if (!wrapper) return 0;
    const rawMaterial = s.rawMaterials.find((m) => m.id === wrapper.rawMaterialId);
    return computePackagingUnitCost(wrapper.gramsPerUnit, rawMaterial);
  },

  boxUnitCost: (boxId) => {
    const s = get();
    const box = s.boxes.find((b) => b.id === boxId);
    if (!box) return 0;
    const rawMaterial = s.rawMaterials.find((m) => m.id === box.rawMaterialId);
    return computePackagingUnitCost(box.gramsPerUnit, rawMaterial);
  },

  // ---------------------------------------------------------------------
  // Carton Configuration (FR-16)
  // ---------------------------------------------------------------------

  loadCartonConfigurations: async () => {
    const { data } = await supabase.from("carton_configurations").select("*").order("created_at", { ascending: false });
    set({ cartonConfigurations: (data ?? []).map(mapCartonConfigRow) });
  },

  addCartonConfiguration: async (input) => {
    const { data, error } = await supabase.functions.invoke("carton-configurations-create", { body: input });
    if (error || !data?.data) throw new Error(error?.message ?? "Failed to add carton configuration");
    await get().loadCartonConfigurations();
    return (data.data as any).id as string;
  },

  updateCartonConfiguration: async (id, patch) => {
    const { data, error } = await supabase.functions.invoke("carton-configurations-update", { body: { id, ...patch } });
    if (error) return { ok: false, reason: error.message };
    await get().loadCartonConfigurations();
    return { ok: true, ...(data as any) };
  },

  // ---------------------------------------------------------------------
  // Production Batch
  // ---------------------------------------------------------------------

  loadProductionBatches: async () => {
    const { data } = await supabase.from("production_batches").select("*").order("batch_date", { ascending: false });
    set({ productionBatches: (data ?? []).map(mapBatchRow) });
  },

  createBatch: async (input) => {
    const { data, error } = await supabase.rpc("fn_create_production_batch", {
      p_consumptions: input.consumptions,
      p_output_yield_kg: input.outputYieldKg,
      p_wastage_kg: input.wastageKg,
      p_leftover_batch_id: input.leftoverBatchId ?? null,
      p_leftover_kg_used: input.leftoverKgUsed ?? null,
      p_other_expenses: input.otherExpenses ?? [],
    });
    if (error || !data) throw new Error(error?.message ?? "Failed to create production batch");
    await Promise.all([get().loadProductionBatches(), get().loadRawMaterialsModule()]);
    return (data as any).batchId as string;
  },

  allocateOverhead: async (batchId, electricity, gas, rent) => {
    const { error } = await supabase.rpc("fn_allocate_overhead", {
      p_batch_id: batchId,
      p_electricity: electricity,
      p_gas: gas,
      p_rent: rent,
    });
    if (error) throw new Error(error.message);
    await get().loadProductionBatches();
  },

  // ---------------------------------------------------------------------
  // Packing Run (FR-23 - FR-31)
  // ---------------------------------------------------------------------

  loadFinishedCartons: async () => {
    const { data } = await supabase.from("finished_cartons").select("*").order("created_at", { ascending: false });
    set({ finishedCartons: (data ?? []).map(mapFinishedCartonRow) });
  },

  createPackingRun: async (input) => {
    const { error } = await supabase.rpc("fn_create_packing_run", {
      p_batch_id: input.batchId,
      p_config_id: input.configId,
      p_cartons_produced: input.cartonsProduced,
    });
    if (error) throw new Error(error.message);
    await Promise.all([
      get().loadFinishedCartons(),
      get().loadProductionBatches(),
      get().loadPackagingModule(),
      get().loadCartonConfigurations(),
    ]);
  },

  // ---------------------------------------------------------------------
  // Customers, Invoicing, Ledger, Payments (FR-32 - FR-45)
  // ---------------------------------------------------------------------

  loadCustomersModule: async () => {
    const [customersRes, pricesRes, invoicesRes, invoiceItemsRes, ledgerRes, paymentsRes] = await Promise.all([
      supabase.from("customers").select("*").order("name"),
      supabase.from("customer_item_prices").select("*"),
      supabase.from("invoices").select("*").order("invoice_date", { ascending: false }),
      supabase.from("invoice_items").select("*"),
      supabase.from("customer_ledger_entries").select("*").order("entry_date", { ascending: false }),
      supabase.from("payments").select("*").order("paid_at", { ascending: false }),
    ]);

    const customers = (customersRes.data ?? []).map(mapCustomerRow);
    const customerNameById = new Map(customers.map((c) => [c.id, c.name]));

    const itemsByInvoiceId = new Map<string, InvoiceLineRecord[]>();
    for (const row of invoiceItemsRes.data ?? []) {
      const list = itemsByInvoiceId.get(row.invoice_id) ?? [];
      list.push(mapInvoiceItemRow(row));
      itemsByInvoiceId.set(row.invoice_id, list);
    }

    const invoices = (invoicesRes.data ?? []).map((row: any) =>
      mapInvoiceRow(row, customerNameById.get(row.customer_id) ?? "", itemsByInvoiceId.get(row.id) ?? [])
    );

    const payments = (paymentsRes.data ?? []).map((row: any) => mapPaymentRow(row, customerNameById.get(row.customer_id) ?? ""));

    set({
      customers,
      customerItemPrices: (pricesRes.data ?? []).map(mapCustomerItemPriceRow),
      invoices,
      ledgerEntries: (ledgerRes.data ?? []).map(mapLedgerRow),
      payments,
    });
  },

  addCustomer: async (item) => {
    const { data, error } = await supabase.functions.invoke("customers-create", {
      body: { name: item.name, phone: item.phone, openingBalance: item.openingBalance },
    });
    if (error || !data?.data) throw new Error(error?.message ?? "Failed to add customer");
    await get().loadCustomersModule();
    return (data.data as any).id as string;
  },

  // FR-42/FR-43: explicit direction required. See LedgerDirection comment
  // above for the sign-convention caveat - confirm with client before go-live.
  recordLedgerEntry: async (customerId, amount, direction, note) => {
    const { error } = await supabase.rpc("fn_record_payment", {
      p_customer_id: customerId,
      p_amount: amount,
      p_direction: direction,
      p_note: note || null,
    });
    if (error) throw new Error(error.message);
    await get().loadCustomersModule();
  },

  lastSoldPriceInfo: (customerId, itemId) => {
    const rec = get().customerItemPrices.find((p) => p.customerId === customerId && p.itemId === itemId);
    return rec ? { price: rec.lastSoldPrice, date: rec.lastSoldDate } : undefined;
  },

  createInvoice: async (input) => {
    const { data, error } = await supabase.rpc("fn_create_invoice", {
      p_customer_id: input.customerId,
      p_lines: input.lines,
    });
    if (error || !data) throw new Error(error?.message ?? "Failed to create invoice");
    await Promise.all([get().loadCustomersModule(), get().loadFinishedCartons()]);
    return (data as any).invoiceNumber ?? (data as any).invoiceId;
  },

  // ---------------------------------------------------------------------
  // Settings
  // ---------------------------------------------------------------------

  loadSettings: async () => {
    const { data } = await supabase.from("app_settings").select("*").eq("id", 1).single();
    if (data) set({ settings: mapSettingsRow(data) });
  },

  updateSettings: async (patch) => {
    const payload: Record<string, unknown> = { id: 1 };
    if (patch.businessName !== undefined) payload.business_name = patch.businessName;
    if (patch.address !== undefined) payload.address = patch.address;
    if (patch.invoiceFooterText !== undefined) payload.invoice_footer_text = patch.invoiceFooterText;
    if (patch.defaultProfitMarginPercent !== undefined) payload.default_profit_margin_percent = patch.defaultProfitMarginPercent;
    if (patch.lowStockThresholdDefault !== undefined) payload.low_stock_threshold_default = patch.lowStockThresholdDefault;

    const { data, error } = await supabase.from("app_settings").upsert(payload).select().single();
    if (error || !data) throw new Error(error?.message ?? "Failed to update settings");
    set({ settings: mapSettingsRow(data) });
  },
}));
